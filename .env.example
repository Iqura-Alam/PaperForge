# PaperForge environment configuration
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env to Git.

# ── Reasoning providers (optional — rule-based fallback if both absent) ──

# Gemini API key (checked first if present)
GEMINI_API_KEY=

# Gemini model to use. Pin a stable model in production; the application
# currently defaults to the stable gemini-2.5-flash identifier.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (used if GEMINI_API_KEY is absent)
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Server ──

# HTTP port (default: 4174)
PORT=4174

# Node environment (development | production)
NODE_ENV=development
